{
  "name": "rubymate",
  "displayName": "Ruby - Complete Ruby and Rails Extension - (RubyMate)",
  "description": "The ultimate Ruby and Rails extension for VS Code. Visual Debugger (rdbg), Test Explorer for RSpec & Minitest, Rails Navigation, ERB/Haml/Slim Template Intelligence with path helpers, RuboCop Auto-format, Go to Definition, Find All References, Code Completion, Syntax Highlighting, and Smart ActiveRecord Intelligence",
  "version": "0.3.2",
  "publisher": "BalajiR",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#CC342D",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20.0.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Snippets",
    "Formatters",
    "Testing",
    "Linters"
  ],
  "keywords": [
    "ruby",
    "rails",
    "ruby extension",
    "ruby vscode",
    "ruby on rails",
    "ruby support",
    "ruby language",
    "ruby intellisense",
    "ruby ide",
    "ruby debugger",
    "ruby debug",
    "rspec",
    "minitest",
    "ruby test",
    "test explorer",
    "ruby testing",
    "rubocop",
    "ruby formatter",
    "ruby linter",
    "ruby autocomplete",
    "ruby code completion",
    "rails ide",
    "rails development",
    "rails debugger",
    "rails testing",
    "activerecord",
    "ruby navigation",
    "go to definition",
    "find references",
    "code intelligence",
    "ruby tools",
    "rails tools",
    "erb",
    "erb intellisense",
    "haml",
    "slim",
    "rails templates",
    "rails helpers",
    "path helpers",
    "bundler",
    "gem",
    "rake",
    "ruby snippets",
    "rails snippets",
    "ruby syntax",
    "syntax highlighting",
    "ruby refactoring",
    "rails navigation",
    "rails generator",
    "ruby workspace",
    "ruby development"
  ],
  "preview": false,
  "qna": "marketplace",
  "badges": [
    {
      "url": "https://img.shields.io/visual-studio-marketplace/v/BalajiR.rubymate",
      "href": "https://marketplace.visualstudio.com/items?itemName=BalajiR.rubymate",
      "description": "Version"
    },
    {
      "url": "https://img.shields.io/visual-studio-marketplace/i/BalajiR.rubymate",
      "href": "https://marketplace.visualstudio.com/items?itemName=BalajiR.rubymate",
      "description": "Installs"
    }
  ],
  "activationEvents": [
    "onLanguage:ruby",
    "onLanguage:erb",
    "onLanguage:haml",
    "onLanguage:slim",
    "workspaceContains:**/*.rb",
    "workspaceContains:**/*.erb",
    "workspaceContains:**/*.haml",
    "workspaceContains:**/*.slim"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "RubyMate runs Ruby tools and debuggers on the workspace host, so it requires a real local, WSL, SSH, container, or Codespaces file system."
    }
  },
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "rubymate.gemExplorer",
          "name": "Gem Explorer",
          "when": "workspaceHasGemfile",
          "icon": "$(package)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "rubymate.gemExplorer",
        "contents": "No Gemfile.lock found in this workspace.\n[Run bundle install](command:rubymate.gems.bundleInstall)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "rubymate.gems.refresh",
          "when": "view == rubymate.gemExplorer",
          "group": "navigation"
        },
        {
          "command": "rubymate.gems.checkOutdated",
          "when": "view == rubymate.gemExplorer",
          "group": "navigation"
        },
        {
          "command": "rubymate.gems.bundleAudit",
          "when": "view == rubymate.gemExplorer"
        },
        {
          "command": "rubymate.gems.bundleInstall",
          "when": "view == rubymate.gemExplorer"
        }
      ],
      "view/item/context": [
        {
          "command": "rubymate.gems.openRubyGems",
          "when": "view == rubymate.gemExplorer && viewItem =~ /^gem/",
          "group": "navigation@1"
        },
        {
          "command": "rubymate.gems.openSourceFromTree",
          "when": "view == rubymate.gemExplorer && viewItem =~ /^gem/",
          "group": "navigation@2"
        },
        {
          "command": "rubymate.gems.bundleUpdate",
          "when": "view == rubymate.gemExplorer && viewItem =~ /^gem/",
          "group": "actions@1"
        },
        {
          "command": "rubymate.gems.copyName",
          "when": "view == rubymate.gemExplorer && viewItem =~ /^gem/",
          "group": "copy@1"
        },
        {
          "command": "rubymate.gems.copyVersion",
          "when": "view == rubymate.gemExplorer && viewItem =~ /^gem/",
          "group": "copy@2"
        }
      ]
    },
    "languages": [
      {
        "id": "ruby",
        "extensions": [
          ".rb",
          ".rake",
          ".gemspec",
          "Rakefile",
          "Gemfile"
        ],
        "aliases": [
          "Ruby",
          "ruby"
        ]
      },
      {
        "id": "erb",
        "extensions": [
          ".erb",
          ".html.erb",
          ".text.erb"
        ],
        "aliases": [
          "ERB",
          "Embedded Ruby",
          "erb"
        ],
        "configuration": "./language-configurations/erb.json"
      },
      {
        "id": "haml",
        "extensions": [
          ".haml",
          ".html.haml"
        ],
        "aliases": [
          "Haml",
          "haml"
        ],
        "configuration": "./language-configurations/haml.json"
      },
      {
        "id": "slim",
        "extensions": [
          ".slim",
          ".html.slim"
        ],
        "aliases": [
          "Slim",
          "slim"
        ],
        "configuration": "./language-configurations/slim.json"
      }
    ],
    "keybindings": [
      {
        "key": "alt+shift+g",
        "command": "rubymate.goToClass",
        "when": "editorLangId == ruby"
      },
      {
        "key": "alt+shift+r",
        "command": "rubymate.navigateToRelated",
        "when": "editorLangId == ruby"
      },
      {
        "key": "alt+shift+t",
