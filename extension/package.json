    "configuration": {
      "title": "RubyMate",
      "properties": {
        "rubymate.formatOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Auto-format Ruby files on save using RuboCop"
        },
        "rubymate.rubyPath": {
          "type": "string",
          "default": "ruby",
          "description": "Path to Ruby executable"
        },
        "rubymate.gemPath": {
          "type": "string",
          "default": "",
          "description": "Path to gems directory (optional)"
        },
        "rubymate.enableRailsSupport": {
          "type": "boolean",
          "default": true,
          "description": "Enable Rails-specific features"
        },
        "rubymate.testFramework": {
          "type": "string",
          "enum": [
            "rspec",
            "minitest",
            "auto"
          ],
          "default": "auto",
          "description": "Test framework to use"
        },
        "rubymate.enableN1Detection": {
          "type": "boolean",
          "default": true,
          "description": "Enable N+1 query detection for ActiveRecord"
        },
        "rubymate.n1DetectionExcludePaths": {
          "type": "array",
          "default": [],
          "description": "Glob patterns to exclude from N+1 detection (e.g., '**/lib/**', '**/services/**')",
          "items": {
            "type": "string"
          }
        },
        "rubymate.autoInsertEnd": {
          "type": "boolean",
          "default": true,
          "description": "Automatically insert 'end' keyword when creating Ruby blocks (def, class, if, etc.)"
        },
        "rubymate.parser.engine": {
          "type": "string",
          "enum": [
            "auto",
            "tree-sitter",
            "legacy"
          ],
          "default": "auto",
          "description": "Parser engine for RubyMate code intelligence. Auto uses Tree-sitter first and falls back to the legacy parser if Tree-sitter cannot parse a file."
        },
        "rubymate.completion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable RubyMate semantic autocompletion (locals, self methods, receiver members, and constants ranked by how the codebase uses them)"
        },
        "rubymate.hotwire.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Hotwire stack support (Stimulus, Turbo Streams, Turbo Frames, Turbo Drive)"
        },
        "rubymate.hotwire.stimulusPath": {
          "type": "string",
          "default": "app/javascript/controllers",
          "description": "Path to Stimulus controllers directory (relative to workspace root)"
        }
      }
    },
    "debuggers": [
      {
        "type": "ruby",
        "label": "Ruby Debug (rdbg)",
        "languages": [
          "ruby"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the Ruby file to debug",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "description": "Command line arguments passed to the program",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Working directory of the program being debugged",
                "default": "${workspaceFolder}"
              },
              "env": {
                "type": "object",
                "description": "Environment variables defined as key-value pairs",
                "default": {}
              },
              "useBundler": {
                "type": "boolean",
                "description": "Use bundle exec to run the debugger",
                "default": true
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Automatically stop after launch",
                "default": false
              },
              "showDebuggerOutput": {
                "type": "boolean",
                "description": "Show debugger output in the debug console",
                "default": false
              },
              "pathMappings": {
                "type": "object",
                "description": "Path mappings for remote debugging",
                "default": {}
              },
              "debuggerStartupTimeout": {
                "type": "number",
                "description": "Timeout in milliseconds for the debugger to start (increase for large Rails apps)",
                "default": 15000
              },
              "useTerminal": {
                "type": "boolean",
                "description": "Run debugger in integrated terminal (required for interactive apps like rails console)",
                "default": false
              },
              "disableSpring": {
                "type": "boolean",
                "description": "Disable Rails Spring preloader (recommended for debugging)",
                "default": false
              },
              "rubyVersionManager": {
                "type": "string",
                "enum": [
                  "auto",
                  "rbenv",
                  "rvm",
                  "asdf",
                  "mise",
                  "chruby",
                  "none"
                ],
                "description": "Ruby version manager to use for PATH setup",
                "default": "auto"
              }
            }
          },
          "attach": {
            "properties": {
              "remoteHost": {
                "type": "string",
                "description": "Remote host to attach to",
                "default": "localhost"
              },
              "remotePort": {
                "type": "number",
                "description": "Remote port to attach to",
                "default": 12345
              },
              "cwd": {
                "type": "string",
                "description": "Working directory",
                "default": "${workspaceFolder}"
              },
              "pathMappings": {
                "type": "object",
                "description": "Path mappings for remote debugging",
                "default": {}
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "ruby",
            "request": "launch",
            "name": "Debug Current File",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "useBundler": true
          },
          {
            "type": "ruby",
            "request": "launch",
            "name": "Debug Rails Server",
            "program": "${workspaceFolder}/bin/rails",
            "args": [
              "server"
            ],
            "cwd": "${workspaceFolder}",
            "useBundler": true,
            "env": {
              "RAILS_ENV": "development"
            }
          },
          {
            "type": "ruby",
            "request": "launch",
            "name": "Run RSpec - Current File",
            "program": "${workspaceFolder}/bin/rspec",
            "args": [
              "${file}"
            ],
            "cwd": "${workspaceFolder}",
            "useBundler": true
          },
          {
            "type": "ruby",
            "request": "attach",
            "name": "Attach to Remote",
            "remoteHost": "localhost",
            "remotePort": 12345
          }
        ],
        "configurationSnippets": [
          {
            "label": "Ruby: Debug Current File",
            "description": "Debug the currently open Ruby file",
            "body": {
              "type": "ruby",
              "request": "launch",
              "name": "Debug Current File",
              "program": "^\"\\${file}\"",
              "cwd": "^\"\\${workspaceFolder}\"",
              "useBundler": true
            }
          },
          {
            "label": "Ruby: Debug Rails Server",
            "description": "Debug Rails server",
            "body": {
